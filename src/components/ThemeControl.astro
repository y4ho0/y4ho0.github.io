---
import { uiAttrs } from "../lib/ui-language";
import "../styles/theme-motion.css";

interface Props { labels?: { system: string; light: string; dark: string }; label?: string; localized?: boolean }
const { labels = { system: "System", light: "Light", dark: "Dark" }, label = "Color theme", localized = false } = Astro.props;
const names = {
  system: { zh: "跟随系统", en: "System" },
  light: { zh: "浅色", en: "Light" },
  dark: { zh: "深色", en: "Dark" },
};
const buttonAttrs = (value: "system" | "light" | "dark") => localized
  ? uiAttrs({ "aria-label": names[value], title: names[value] })
  : { "aria-label": labels[value], title: labels[value] };
---
<div class="theme-control" role="group" {...(localized ? uiAttrs({ "aria-label": { zh: "颜色主题", en: "Color theme" } }) : { "aria-label": label })}>
  <button type="button" data-theme-value="system" aria-pressed="true" {...buttonAttrs("system")}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
  </button>
  <button type="button" data-theme-value="light" aria-pressed="false" {...buttonAttrs("light")}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
  </button>
  <button type="button" data-theme-value="dark" aria-pressed="false" {...buttonAttrs("dark")}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.9 13.2A9 9 0 0 1 10.8 3.1a9 9 0 1 0 10.1 10.1Z" /></svg>
  </button>
</div>

<script>
  const storageKey = "garden-theme";
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theme-value]"));
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let currentPreference = "system";
  let cleanupTimer: number | undefined;

  function readPreference() {
    try {
      const value = localStorage.getItem(storageKey);
      return value === "light" || value === "dark" ? value : "system";
    } catch { return currentPreference; }
  }

  function applyTheme(preference: string, animate = false) {
    currentPreference = preference;
    const root = document.documentElement;
    const resolved = preference === "system" ? (media.matches ? "dark" : "light") : preference;
    if (!animate || reducedMotion.matches) {
      window.clearTimeout(cleanupTimer);
      delete root.dataset.themeTransition;
    } else if (root.dataset.theme !== resolved) {
      window.clearTimeout(cleanupTimer);
      root.dataset.themeTransition = "colors";
      // Establish the old root palette before changing its shared color values.
      // Descendants inherit one animation; inputs and writing stay interactive.
      getComputedStyle(root).getPropertyValue("--color-background");
      cleanupTimer = window.setTimeout(() => { delete root.dataset.themeTransition; }, 800);
    }
    root.dataset.theme = resolved;
    root.dataset.themePreference = preference;
    document.querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", resolved === "dark" ? "#10151c" : "#f4f0e6");
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.themeValue === preference));
    });
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const preference = button.dataset.themeValue ?? "system";
      try { localStorage.setItem(storageKey, preference); } catch { /* Use this page's preference when storage is unavailable. */ }
      applyTheme(preference, true);
    });
  });

  media.addEventListener("change", () => {
    if (currentPreference === "system") applyTheme("system", true);
  });
  window.addEventListener("storage", (event) => { if (event.key === storageKey || event.key === null) applyTheme(readPreference(), true); });
  reducedMotion.addEventListener("change", () => { if (reducedMotion.matches) applyTheme(currentPreference); });

  applyTheme(readPreference());
</script>
