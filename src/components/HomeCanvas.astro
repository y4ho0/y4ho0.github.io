<canvas class="home-canvas" aria-hidden="true">Decorative character clouds forming and reforming into objects selected from a library of more than twenty knowledge, science, and computing symbols.</canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".home-canvas");
  const context = canvas?.getContext("2d", { alpha: true });
  const hero = canvas?.closest<HTMLElement>(".hero");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const narrowScreen = window.matchMedia("(max-width: 48rem)");
  const phoneScreen = window.matchMedia("(max-width: 30rem)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  const ambientGlyphs = [
    "0", "1", "λ", "π", "∑", "#", "$", "%", "&", "@", "!", "?", "=", "-", "_",
    ":", ";", "(", ")", "[", "]", "{", "}", "<", ">", "/", "+", "·", "*", "^", "|", "~", "≈",
  ];
  let particleCount = 42;
  const initialDuration = 2350;
  const holdDuration = 5200;
  const morphDuration = 3200;

  const shapeKinds = [
    "atom",
    "book",
    "terminal",
    "flask",
    "planet",
    "cube",
    "binary-tree",
    "compass",
    "telescope",
    "hourglass",
