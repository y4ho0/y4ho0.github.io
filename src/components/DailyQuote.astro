---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

interface Quote {
  date: string;
  text: string;
  author: string | null;
  source: string | null;
  language: "en" | "zh";
  provider: string | null;
  providerUrl: string | null;
  status: "fresh" | "fallback" | "hidden";
}

let quote: Quote | null = null;
try {
  quote = JSON.parse(await readFile(resolve("public/data/daily-quote.json"), "utf8"));
} catch {
  quote = null;
}

const attribution = quote?.author || quote?.source;
const providerUrl = quote?.providerUrl?.startsWith("https://") ? quote.providerUrl : null;
const quoteLength = Array.from(quote?.text ?? "").length;
const shortLimit = quote?.language === "zh" ? 34 : 70;
const longLimit = quote?.language === "zh" ? 72 : 150;
const quoteSize = quoteLength <= shortLimit ? "short" : quoteLength > longLimit ? "long" : "medium";
---

{quote?.text && quote.status !== "hidden" && (
  <figure
    class:list={["daily-quote", `daily-quote--${quoteSize}`]}
    data-quote-language={quote.language}
    data-quote-size={quoteSize}
    data-quote-text={quote.text}
    data-quote-date={quote.date}
    data-quote-animation="pending"
    data-pagefind-ignore="all"
  >
    <blockquote lang={quote.language} aria-label={quote.text}>
      <p class="daily-quote__text">
        <span class="daily-quote__sizer" aria-hidden="true">{quote.text}</span>
        <span class="daily-quote__typing" aria-hidden="true">
          <span class="daily-quote__output"></span><span class="daily-quote__cursor"></span>
        </span>
      </p>
    </blockquote>
    {(attribution || providerUrl) && (
      <figcaption>
        {attribution && <span>— {attribution}{quote.author && quote.source ? `, ${quote.source}` : ""}</span>}
        {providerUrl && <a href={providerUrl} rel="external noreferrer">{quote.provider}</a>}
      </figcaption>
    )}
  </figure>
)}

<script>
  function initializeQuoteAnimation() {
    const figure = document.querySelector<HTMLElement>(".daily-quote[data-quote-animation]");
    if (!figure) return;
    const output = figure.querySelector<HTMLElement>(".daily-quote__output");
    if (!output) return;
    const quoteFigure = figure;
    const quoteOutput = output;

    const existingState = quoteFigure.dataset.quoteAnimation;
    if (existingState === "typing" || existingState === "complete" || existingState === "direct") return;

    const text = quoteFigure.dataset.quoteText ?? "";
    const language = quoteFigure.dataset.quoteLanguage ?? "en";
    const characters = Array.from(text);
    const totalDuration = Math.min(3600, Math.max(1100, 700 + characters.length * 25));
    const stepDuration = totalDuration / Math.max(1, characters.length);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let started = false;
    let startQueued = false;
    let quoteIsInViewport = false;
    let index = 0;
    let accumulatedTime = 0;
    let lastFrameTime = 0;
    let typingFrame = 0;
    let firstPaintFrame = 0;
    let secondPaintFrame = 0;
    let currentWord: HTMLSpanElement | null = null;
    let observer: IntersectionObserver | null = null;
    let usingViewportFallback = false;

    quoteFigure.dataset.quoteAnimation = "waiting";
    quoteOutput.replaceChildren();

    function stopViewportWatch() {
      observer?.disconnect();
      observer = null;
      if (usingViewportFallback) {
        window.removeEventListener("scroll", checkViewportFallback);
        window.removeEventListener("resize", checkViewportFallback);
        usingViewportFallback = false;
      }
    }

    function cancelQueuedStart() {
      if (firstPaintFrame) cancelAnimationFrame(firstPaintFrame);
      if (secondPaintFrame) cancelAnimationFrame(secondPaintFrame);
      firstPaintFrame = 0;
      secondPaintFrame = 0;
      startQueued = false;
    }

    function stopTypingFrame() {
      if (typingFrame) cancelAnimationFrame(typingFrame);
      typingFrame = 0;
      lastFrameTime = 0;
    }

    function showDirectly() {
      started = true;
      cancelQueuedStart();
      stopTypingFrame();
      stopViewportWatch();
      quoteOutput.replaceChildren();
      quoteFigure.dataset.quoteAnimation = "direct";
    }

    function appendCharacter(character: string) {
      if (/\s/u.test(character)) {
        quoteOutput.append(document.createTextNode(character));
        currentWord = null;
        return;
      }

      const characterElement = document.createElement("span");
      characterElement.className = "daily-quote__character";
      characterElement.textContent = character;
      if (language === "en") {
        if (!currentWord) {
          currentWord = document.createElement("span");
          currentWord.className = "daily-quote__word";
          quoteOutput.append(currentWord);
        }
        currentWord.append(characterElement);
      } else {
        quoteOutput.append(characterElement);
      }
      characterElement.animate(
        [
          { opacity: 0, transform: "translateY(0.12em)" },
          { opacity: 1, transform: "translateY(0)" },
        ],
        { duration: Math.min(180, Math.max(90, stepDuration * 2.4)), easing: "ease-out", fill: "both" },
      );
    }

    function requestTypingFrame() {
      if (
        typingFrame
        || document.visibilityState !== "visible"
        || quoteFigure.dataset.quoteAnimation !== "typing"
      ) return;
      typingFrame = requestAnimationFrame(typeFrame);
    }

    function typeFrame(time: number) {
      typingFrame = 0;
      if (reduceMotion.matches) {
        showDirectly();
        return;
      }
      if (document.visibilityState !== "visible") {
        lastFrameTime = 0;
        return;
      }

      if (lastFrameTime) {
        accumulatedTime += Math.min(time - lastFrameTime, stepDuration * 2);
      }
      lastFrameTime = time;

      let charactersThisFrame = Math.min(2, Math.floor(accumulatedTime / stepDuration));
      while (index < characters.length && charactersThisFrame > 0) {
        appendCharacter(characters[index]);
        index += 1;
        charactersThisFrame -= 1;
        accumulatedTime -= stepDuration;
      }

      if (index < characters.length) {
        requestTypingFrame();
      } else {
        quoteFigure.dataset.quoteAnimation = "complete";
      }
    }

    function startTyping() {
      if (started || reduceMotion.matches || document.visibilityState !== "visible" || !quoteIsInViewport) return;
      started = true;
      stopViewportWatch();
      quoteOutput.replaceChildren();
      quoteFigure.dataset.quoteAnimation = "typing";
      accumulatedTime = stepDuration;
      requestTypingFrame();
    }

    function canStart() {
      return !started
        && !reduceMotion.matches
        && document.visibilityState === "visible"
        && quoteIsInViewport;
    }

    function tryStart() {
      if (startQueued || !canStart()) return;
      startQueued = true;
      firstPaintFrame = requestAnimationFrame(() => {
        firstPaintFrame = 0;
        if (!canStart()) {
          startQueued = false;
          return;
        }
        secondPaintFrame = requestAnimationFrame(() => {
          secondPaintFrame = 0;
          startQueued = false;
          if (canStart()) startTyping();
        });
      });
    }

    function checkViewportFallback() {
      const bounds = quoteFigure.getBoundingClientRect();
      const visibleHeight = Math.max(0, Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, 0));
      const referenceHeight = Math.max(1, Math.min(bounds.height, window.innerHeight));
      quoteIsInViewport = bounds.width > 0 && visibleHeight / referenceHeight >= 0.35;
      if (!quoteIsInViewport) cancelQueuedStart();
      tryStart();
    }

    function watchViewport() {
      const supportsIntersectionObserver = typeof window.IntersectionObserver === "function";
      if (supportsIntersectionObserver) {
        observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          quoteIsInViewport = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.35);
          if (!quoteIsInViewport) cancelQueuedStart();
          tryStart();
        }, { threshold: [0, 0.35] });
        observer.observe(quoteFigure);
      } else {
        usingViewportFallback = true;
        window.addEventListener("scroll", checkViewportFallback, { passive: true });
        window.addEventListener("resize", checkViewportFallback, { passive: true });
        checkViewportFallback();
      }
    }

    function handleVisibilityChange() {
      if (document.visibilityState !== "visible") {
        cancelQueuedStart();
        stopTypingFrame();
        return;
      }
      if (quoteFigure.dataset.quoteAnimation === "typing") {
        requestTypingFrame();
      } else {
        tryStart();
      }
    }

    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) showDirectly();
    });
    document.addEventListener("visibilitychange", handleVisibilityChange);
    window.addEventListener("pageshow", (event) => {
      const state = quoteFigure.dataset.quoteAnimation;
      if (event.persisted && (state === "complete" || state === "direct")) return;
      if (state === "typing") requestTypingFrame();
      else tryStart();
    });

    if (!text || reduceMotion.matches) {
      showDirectly();
    } else {
      watchViewport();
    }
  }

  initializeQuoteAnimation();
</script>
