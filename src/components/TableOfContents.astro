---
import UiText from "./UiText.astro";
import { uiAttrs } from "../lib/ui-language";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const visible = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{visible.length > 1 && (
  <nav class="table-of-contents" {...uiAttrs({ "aria-label": { zh: "本文目录", en: "On this page" } })}>
    <p><UiText zh="本文目录" en="On this page" /></p>
    <ol>
      {visible.map((heading) => (
        <li class:list={[`toc-depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
