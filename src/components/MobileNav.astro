---
import ThemeControl from "./ThemeControl.astro";
import LanguageControl from "./LanguageControl.astro";
import SearchIcon from "./SearchIcon.astro";
import UiText from "./UiText.astro";
import { uiAttrs } from "../lib/ui-language";

const pathname = Astro.url.pathname;
const links = [
  ["花园", "Garden", "/garden/"],
  ["课程", "Courses", "/courses/"],
  ["实验", "Labs", "/labs/"],
  ["随笔", "Essays", "/essays/"],
  ["归档", "Archive", "/archive/"],
  ["关于", "About", "/about/"],
] as const;
---

<button class="mobile-menu-trigger" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false"><UiText zh="菜单" en="Menu" /></button>
<dialog class="mobile-menu" id="mobile-menu" aria-labelledby="mobile-menu-title">
  <div class="mobile-menu__header">
    <span id="mobile-menu-title"><UiText zh="逛逛花园" en="Explore the garden" /></span>
    <div class="mobile-menu__actions">
      <a class="mobile-menu__search-link" href="/search/" {...uiAttrs({ "aria-label": { zh: "搜索", en: "Search" }, title: { zh: "搜索", en: "Search" } })}><SearchIcon /></a>
      <button class="mobile-menu__close" type="button" {...uiAttrs({ "aria-label": { zh: "关闭菜单", en: "Close menu" } })}><UiText zh="关闭" en="Close" /></button>
    </div>
  </div>
  <nav {...uiAttrs({ "aria-label": { zh: "移动导航", en: "Mobile navigation" } })}>
    {links.map(([zh, en, href]) => <a href={href} aria-current={pathname.startsWith(href) ? "page" : undefined}><UiText zh={zh} en={en} /></a>)}
  </nav>
  <div class="mobile-menu__theme"><span><UiText zh="主题" en="Theme" /></span><ThemeControl localized /></div>
  <div class="mobile-menu__theme"><span><UiText zh="语言" en="Language" /></span><LanguageControl /></div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const openButton = document.querySelector<HTMLButtonElement>(".mobile-menu-trigger");
  const closeButton = dialog?.querySelector<HTMLButtonElement>(".mobile-menu__close");
  const focusableSelector = "a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex='-1'])";
  let navigating = false;
  openButton?.addEventListener("click", () => {
    if (!dialog) return;
    navigating = false;
    dialog.showModal();
    openButton.setAttribute("aria-expanded", "true");
    window.requestAnimationFrame(() => closeButton?.focus());
  });
  closeButton?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[href]");
    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (link.hasAttribute("download") || (link.target && link.target !== "_self")) return;
    if (link.origin !== location.origin) return;
    // Close before the browser captures the outgoing page. Native navigation
    // and modified-click behavior remain unchanged; no timer delays the link.
    navigating = true;
    dialog.close();
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      dialog.close();
      return;
    }
    if (event.key !== "Tab") return;
    const focusable = Array.from(dialog.querySelectorAll<HTMLElement>(focusableSelector));
    const first = focusable[0];
    const last = focusable.at(-1);
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
  dialog?.addEventListener("close", () => {
    openButton?.setAttribute("aria-expanded", "false");
    if (!navigating) openButton?.focus();
  });
</script>
