---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="HDFS 写入流程 · 交互原型" description="按步骤理解 NameNode、DataNode 写入管道与确认机制。">
  <main class="site-shell demo" data-demo-root>
    <p class="eyebrow">SYSTEMS / INTERACTIVE EXPLAINER</p>
    <h1>HDFS 文件写入 · 流程原型</h1>
    <p class="muted">这是对 HDFS 主要交互的简化可视化，不是实际集群，也不涵盖完整协议或全部异常路径。</p>
    <div class="diagram" role="img" aria-label="客户端经过 NameNode 建立文件，并向三个 DataNode 形成写入管道">
      <div class="node client" data-node="client">Client<small>发起写入</small></div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="node master" data-node="master">NameNode<small>元数据</small></div>
      <div class="pipeline" aria-label="DataNode 数据管道">
        <div class="node" data-node="dn1">DataNode A<small>Block replica</small></div>
        <span aria-hidden="true">→</span>
        <div class="node" data-node="dn2">DataNode B<small>Block replica</small></div>
        <span aria-hidden="true">→</span>
        <div class="node" data-node="dn3">DataNode C<small>Block replica</small></div>
      </div>
    </div>
    <section class="stage" aria-live="polite">
      <span class="stage-count" id="stage-count">01 / 04</span>
      <h2 id="stage-title">向 NameNode 申请创建</h2>
      <p id="stage-description">客户端请求创建指定路径。NameNode 检查命名空间和权限，并准备管理后续的数据块信息。</p>
    </section>
    <div class="controls">
      <button type="button" id="previous" disabled>上一步</button>
      <button type="button" id="next">下一步</button>
      <button type="button" id="restart">重新开始</button>
    </div>
    <p class="foot">示意流程按经典 HDFS 读写设计组织。真实写入涉及数据包、确认链、心跳、校验、异常恢复以及具体副本放置策略。节点数是概念示例，非当前伪分布式实验的实测结果。</p>
    <p><a href="/courses/">返回课程目录</a></p>
  </main>
</BaseLayout>
<style>
  .demo{padding-block:3rem 5rem;max-width:66rem}
  h1{font:400 clamp(1.8rem,4vw,2.6rem) var(--font-body);line-height:1.3;margin:0 0 1rem}
  .muted,.foot{color:var(--color-muted-readable)}
  .diagram{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;padding:2rem 1rem;border:1px solid var(--color-border);border-radius:.9rem;background:var(--color-surface);margin-top:2rem}
  .node{padding:1rem;border:1px solid var(--color-border);border-radius:.65rem;background:var(--color-surface-raised);min-width:8.5rem;text-align:center;transition:background .18s,border-color .18s}
  .node small{display:block;font-size:.75rem;margin-top:.3rem;color:var(--color-muted-readable)}
  .node[data-active="true"]{background:color-mix(in srgb,var(--color-primary) 21%,var(--color-surface-raised));border-color:var(--color-action)}
  .arrow{font-size:1.7rem;color:var(--color-muted-readable)}
  .pipeline{width:100%;display:flex;align-items:center;flex-wrap:wrap;gap:.6rem;margin-top:1.25rem}
  .pipeline>span{color:var(--color-muted-readable);font-size:1.2rem}
  .stage{margin-top:1.5rem;background:var(--color-surface-raised);border-radius:.75rem;padding:1.5rem;border:1px solid var(--color-border);min-height:10rem}
  .stage-count{color:var(--color-action);font-size:.8rem}
  .stage h2{margin:.5rem 0;font-size:1.2rem}
  .stage p{margin:0;line-height:1.7}
  .controls{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}
  .controls button{min-height:44px;border-radius:.5rem;border:1px solid var(--color-border);padding:.55rem 1.1rem;background:var(--color-surface);color:var(--color-text);cursor:pointer;font:inherit}
  .controls button:disabled{opacity:.45;cursor:default}
  .controls button:focus-visible{outline:2px solid var(--color-action);outline-offset:3px}
  .foot{line-height:1.75;max-width:57rem;font-size:.9rem;margin-block:2rem}
  @media(prefers-reduced-motion:reduce){.node{transition:none}}
</style>
<script>
  const stages = [
    ["向 NameNode 申请创建","客户端请求创建指定路径。NameNode 检查命名空间和权限，并准备管理后续的数据块信息。",["client","master"]],
    ["确定数据块目标","NameNode 根据可用节点、位置与副本策略返回写入目标。实际集群的副本数量及节点选择由配置决定。",["master","dn1"]],
    ["建立 DataNode Pipeline","客户端向第一个 DataNode 发送数据包，节点之间依次转发。这里三个节点仅用于解释多副本机制。",["client","dn1","dn2","dn3"]],
    ["数据确认与文件完成","副本节点沿管道确认数据包，客户端最终完成写入和关闭。失败后的替换管道与恢复过程未在此示意。",["client","dn1","dn2","dn3"]],
  ] as const;
  let index = 0;
  const root = document.querySelector<HTMLElement>("[data-demo-root]");
  const prev = root?.querySelector<HTMLButtonElement>("#previous");
  const next = root?.querySelector<HTMLButtonElement>("#next");
  function render() {
    if (!root) return;
    root.querySelector<HTMLElement>("#stage-count")!.textContent = String(index + 1).padStart(2,"0") + " / 04";
    root.querySelector<HTMLElement>("#stage-title")!.textContent = stages[index][0];
    root.querySelector<HTMLElement>("#stage-description")!.textContent = stages[index][1];
    root.querySelectorAll<HTMLElement>("[data-node]").forEach(el => { el.dataset.active = String((stages[index][2] as readonly string[]).includes(el.dataset.node ?? "")); });
    if (prev) prev.disabled = index === 0;
    if (next) next.disabled = index === stages.length - 1;
  }
  prev?.addEventListener("click", () => {index = Math.max(0,index-1);render()});
  next?.addEventListener("click", () => {index = Math.min(stages.length-1,index+1);render()});
  root?.querySelector("#restart")?.addEventListener("click", () => {index = 0;render()});
  render();
</script>
