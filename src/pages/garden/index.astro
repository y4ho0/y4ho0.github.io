---
import UiText from "../../components/UiText.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { byUpdatedDate, getPublishedNotes } from "../../lib/content";

const notes = byUpdatedDate((await getPublishedNotes()).filter((entry) => !entry.data.course));
---

<BaseLayout title="花园" titleEn="Garden" description="花园中独立生长的笔记。" descriptionEn="Standalone notes in the garden.">
  <section class="page-shell site-shell">
    <header class="page-header"><h1><UiText zh="花园" en="Garden" /></h1></header>
    {notes.length > 0 ? <div class="content-grid">{notes.map((entry) => <ContentCard entry={entry} />)}</div> : <p class="empty-state"><UiText zh="暂时还没有公开笔记。" en="No public notes yet." /></p>}
  </section>
</BaseLayout>
