---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { byUpdatedDate, getPublishedCourses } from "../../lib/content";
const courses = byUpdatedDate(await getPublishedCourses());
---

<BaseLayout title="Courses" description="Course-shaped collections of connected notes and experiments.">
  <section class="page-shell site-shell">
    <header class="page-header"><p class="eyebrow">Courses</p><h1>Connected paths</h1><p>Courses are structural containers, not claims of enrollment or progress.</p></header>
    {courses.length > 0 ? <div class="content-grid">{courses.map((entry) => <ContentCard entry={entry} />)}</div> : <p class="empty-state">No public courses yet.</p>}
  </section>
</BaseLayout>
