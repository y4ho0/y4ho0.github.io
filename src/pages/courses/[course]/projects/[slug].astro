---
import { getEntry, render } from "astro:content";
import ArticleLayout from "../../../../layouts/ArticleLayout.astro";
import { getPublishedProjects, resolveRelated } from "../../../../lib/content";

export async function getStaticPaths() {
  const entries = await getPublishedProjects();
  return entries.map((entry) => ({ params: { course: entry.data.course.id, slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const course = await getEntry(entry.data.course);
if (!course) throw new Error(`Missing course for projects/${entry.id}`);
const { Content, headings } = await render(entry);
const related = await resolveRelated(entry);
---

<ArticleLayout entry={entry} breadcrumbs={[{ label: "首页", labelEn: "Home", href: "/" }, { label: "课程", labelEn: "Courses", href: "/courses/" }, { label: course.data.title, href: `/courses/${course.id}/` }, { label: entry.data.title }]} related={related} headings={headings}><Content /></ArticleLayout>
