---
import UiText from "../components/UiText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import DuckMark from "../components/DuckMark.astro";
---

<BaseLayout title="页面未找到" titleEn="Page not found" description="请求的路径不存在。" descriptionEn="The requested path does not exist." noindex>
  <section class="not-found site-shell">
    <DuckMark size="large" />
    <p class="eyebrow">404</p>
    <h1><UiText zh="这里还没有长出这条小径。" en="This path has not grown here." /></h1>
    <p><UiText zh="页面可能已经搬走，也可能还未在这里种下。" en="The page may have moved, or it may never have been planted." /></p>
    <a class="button-link" href="/"><UiText zh="返回花园" en="Return to the garden" /></a>
  </section>
</BaseLayout>
