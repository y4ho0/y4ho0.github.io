---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getPublishedEssays, resolveRelated } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getPublishedEssays();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = await resolveRelated(entry);
---

<ArticleLayout entry={entry} breadcrumbs={[{ label: "Home", href: "/" }, { label: "Essays", href: "/essays/" }, { label: entry.data.title }]} related={related} headings={headings}>
  <Content />
</ArticleLayout>
