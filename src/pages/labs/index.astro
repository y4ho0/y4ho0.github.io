---
import UiText from "../../components/UiText.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { byUpdatedDate, getPublishedLabs } from "../../lib/content";
const labs = byUpdatedDate(await getPublishedLabs());
---

<BaseLayout title="实验" titleEn="Labs" description="记录小型实验的过程与结果。" descriptionEn="Small, documented experiments.">
  <section class="page-shell site-shell">
    <header class="page-header"><h1><UiText zh="实验" en="Labs" /></h1></header>
    {labs.length > 0 ? <div class="content-grid">{labs.map((entry) => <ContentCard entry={entry} />)}</div> : <p class="empty-state"><UiText zh="暂时还没有公开实验。" en="No public labs yet." /></p>}
  </section>
</BaseLayout>
