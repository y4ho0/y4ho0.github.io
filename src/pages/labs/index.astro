---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { byUpdatedDate, getPublishedLabs } from "../../lib/content";
const labs = byUpdatedDate(await getPublishedLabs());
---

<BaseLayout title="Labs" description="Small, documented experiments.">
  <section class="page-shell site-shell">
    <header class="page-header"><p class="eyebrow">Labs</p><h1>Experiments, documented</h1><p>Labs appear only when a real experiment has been written up.</p></header>
    {labs.length > 0 ? <div class="content-grid">{labs.map((entry) => <ContentCard entry={entry} />)}</div> : <p class="empty-state">No public labs yet.</p>}
  </section>
</BaseLayout>
