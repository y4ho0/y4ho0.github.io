---
import BaseLayout from "./BaseLayout.astro";
import UiText from "../components/UiText.astro";
import { uiAttrs } from "../lib/ui-language";
import "katex/dist/katex.min.css";
import "../styles/knowledge-tools.css";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RelatedContent from "../components/RelatedContent.astro";
import TableOfContents from "../components/TableOfContents.astro";
import type { AnyContentEntry } from "../lib/content-routing";
import { collectionLabel } from "../lib/content-routing";

interface Props {
  entry: AnyContentEntry;
  breadcrumbs: { label: string; labelEn?: string; href?: string }[];
  related?: AnyContentEntry[];
  headings?: { depth: number; slug: string; text: string }[];
}

const { entry, breadcrumbs, related = [], headings = [] } = Astro.props;
const publishedAt = entry.data.publishedAt;
const collectionZh = { courses: "课程", notes: "笔记", labs: "实验", projects: "项目", essays: "随笔" };
const statusLabels = { seedling: { zh: "萌芽", en: "Seedling" }, growing: { zh: "成长", en: "Growing" }, evergreen: { zh: "常青", en: "Evergreen" } };
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath={Astro.url.pathname} type="article" publishedAt={publishedAt} updatedAt={entry.data.updatedAt}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article class="article-shell">
    <span data-filter-value={collectionLabel(entry.collection)} data-pagefind-filter="type[data-filter-value]" data-pagefind-ignore></span>
    {entry.data.tags.map((tag) => <span data-filter-value={tag} data-pagefind-filter="tag[data-filter-value]" data-pagefind-ignore></span>)}
    {"course" in entry.data && entry.data.course && <span data-filter-value={entry.data.course.id} data-pagefind-filter="course[data-filter-value]" data-pagefind-ignore></span>}
    <Breadcrumbs items={breadcrumbs} />
    <header class="article-header">
      <p class="eyebrow"><UiText zh={collectionZh[entry.collection]} en={collectionLabel(entry.collection)} /></p>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p data-pagefind-meta="description">{entry.data.description}</p>
      <dl class="article-meta">
        <div><dt><UiText zh="成长状态" en="Status" /></dt><dd><UiText {...statusLabels[entry.data.status]} /></dd></div>
        {publishedAt && <div><dt><UiText zh="发布于" en="Published" /></dt><dd><time datetime={publishedAt.toISOString()} data-ui-date={publishedAt.toISOString()}>{publishedAt.toLocaleDateString("zh-CN", { timeZone: "UTC" })}</time></dd></div>}
        <div><dt><UiText zh="更新于" en="Updated" /></dt><dd><time datetime={entry.data.updatedAt.toISOString()} data-ui-date={entry.data.updatedAt.toISOString()}>{entry.data.updatedAt.toLocaleDateString("zh-CN", { timeZone: "UTC" })}</time></dd></div>
      </dl>
      {entry.data.tags.length > 0 && <ul class="tag-list" {...uiAttrs({ "aria-label": { zh: "标签", en: "Tags" } })}>{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    </header>
    <div class="article-reading-grid">
      <div class="prose" data-pagefind-body>
        <slot />
      </div>
      <TableOfContents headings={headings} />
    </div>
    <slot name="after" />
    <RelatedContent entries={related} />
  </article>
</BaseLayout>

<script>
  import { setUiMessage, setUiAttribute } from "../lib/ui-language";

  document.querySelectorAll<HTMLElement>(".prose pre").forEach((block) => {
    if (block.querySelector(".code-copy")) return;
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    setUiMessage(button, "复制", "Copy");
    setUiAttribute(button, "aria-label", "复制代码", "Copy code");
    button.addEventListener("click", async () => {
      const code = block.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        setUiMessage(button, "已复制", "Copied");
      } catch {
        setUiMessage(button, "请选中代码复制", "Select to copy");
      }
      window.setTimeout(() => setUiMessage(button, "复制", "Copy"), 1800);
    });
    block.append(button);
  });

  // Progressive enhancement: CSS handles hover/focus even without JS.
  // Delegated events avoid attaching a listener for every terminology instance.
  const termRoot = document.querySelector<HTMLElement>(".article-shell");
  let opened: HTMLElement | null = null;
  const closeTerm = () => {
    if (opened) { opened.classList.remove("is-open"); opened.setAttribute("aria-expanded", "false"); }
    opened = null;
  };
  const revealTerm = (term: HTMLElement) => {
    if (opened !== term) closeTerm();
    opened = term;
    term.classList.add("is-open");
    term.setAttribute("aria-expanded", "true");
    const bounds = term.getBoundingClientRect();
    term.dataset.side = bounds.left > window.innerWidth * .62 ? "right" : "left";
  };
  termRoot?.addEventListener("pointerover", event => {
    if (matchMedia("(hover: hover)").matches) {
      const term = (event.target as Element).closest<HTMLElement>(".term-note");
      if (term) revealTerm(term);
    }
  });
  termRoot?.addEventListener("pointerout", event => {
    const term = (event.target as Element).closest<HTMLElement>(".term-note");
    if (term && !term.contains(event.relatedTarget as Node | null) && term !== document.activeElement) closeTerm();
  });
  termRoot?.addEventListener("focusin", event => {
    const term = (event.target as Element).closest<HTMLElement>(".term-note");
    if (term) revealTerm(term);
  });
  termRoot?.addEventListener("focusout", event => {
    const term = (event.target as Element).closest<HTMLElement>(".term-note");
    if (term && opened === term) closeTerm();
  });
  termRoot?.addEventListener("click", event => {
    const term = (event.target as Element).closest<HTMLElement>(".term-note");
    if (term) { revealTerm(term); term.focus(); }
    else if (opened) { opened.blur(); closeTerm(); }
  });
  termRoot?.addEventListener("keydown", event => {
    const term = (event.target as Element).closest<HTMLElement>(".term-note");
    if (event.key === "Escape") { if (opened) { event.preventDefault(); opened.blur(); closeTerm(); } }
    else if (term && (event.key === "Enter" || event.key === " ")) {
      event.preventDefault();
      revealTerm(term);
    }
  });
  const article = document.querySelector<HTMLElement>(".article-shell");
  const progress = document.querySelector<HTMLElement>(".reading-progress span");
  const headings = Array.from(document.querySelectorAll<HTMLElement>(".prose :is(h2, h3, h4)[id]"));
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".table-of-contents a[href^='#']"));
  let readingFrame = 0;

  headings.forEach((heading) => {
    if (heading.querySelector(".heading-anchor")) return;
    const label = heading.textContent?.trim();
    const anchor = document.createElement("a");
    anchor.className = "heading-anchor";
    anchor.href = `#${heading.id}`;
    anchor.textContent = "#";
    setUiAttribute(anchor, "aria-label", `跳转到${label || "章节"}`, `Link to ${label || "section"}`);
    heading.append(anchor);
  });

  function updateReadingState() {
    readingFrame = 0;
    if (article && progress) {
      const start = article.offsetTop;
      const distance = Math.max(1, article.scrollHeight - window.innerHeight);
      const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      progress.style.transform = `scaleX(${value})`;
    }

    if (headings.length > 0 && tocLinks.length > 0) {
      let current = headings[0].id;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= window.innerHeight * 0.32) current = heading.id;
        else break;
      }
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        current = headings.at(-1)?.id ?? current;
      }
      tocLinks.forEach((link) => {
        const target = decodeURIComponent(link.hash.slice(1));
        if (target === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }
  }

  function scheduleReadingUpdate() {
    if (!readingFrame) readingFrame = window.requestAnimationFrame(updateReadingState);
  }

  window.addEventListener("scroll", scheduleReadingUpdate, { passive: true });
  window.addEventListener("resize", scheduleReadingUpdate, { passive: true });
  updateReadingState();
</script>
