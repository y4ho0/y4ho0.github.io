---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  imagePath?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
}

const {
  title = "y4ho0's Garden",
  description = "A quiet digital garden for notes, experiments, projects, and essays.",
  canonicalPath = Astro.url.pathname,
  imagePath = "/og.png",
  type = "website",
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;
const pageTitle = title === "y4ho0's Garden" ? title : `${title} · y4ho0's Garden`;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(imagePath, Astro.site);
const structuredData = type === "article"
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      datePublished: publishedAt?.toISOString(),
      dateModified: updatedAt?.toISOString(),
      mainEntityOfPage: canonical.toString(),
      image: socialImage.toString(),
      author: { "@type": "Person", name: "y4ho0" },
    }
  : canonical.pathname === "/"
    ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "y4ho0's Garden",
      description,
      url: canonical.toString(),
    }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description,
        url: canonical.toString(),
      };
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="y4ho0's Garden" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="y4ho0's Garden, a quiet digital garden" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="y4ho0's Garden, a quiet digital garden" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="preload" href="/fonts/source-serif-4-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("garden-theme");
        const preference = stored === "light" || stored === "dark" ? stored : "system";
        const resolved = preference === "system"
          ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          : preference;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themePreference = preference;
        const color = resolved === "dark" ? "#10151c" : "#f4f0e6";
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", color);
      })();
    </script>
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main
      id="main-content"
      class="site-main"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
