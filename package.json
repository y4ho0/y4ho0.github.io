{
  "name": "y4ho0-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "content:check": "node scripts/check-content.mjs",
    "check": "astro check && npm run content:check",
    "quote:generate": "node scripts/generate-daily-quote.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:astro": "astro build",
    "build:search": "pagefind --site dist --root-selector '[data-pagefind-body]'",
    "build:verify": "node scripts/verify-dist.mjs",
    "build": "npm run quote:generate && npm run build:astro && npm run build:search && npm run build:verify",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "astro": "^6.4.8",
    "cobe": "^2.0.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.13.3",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  }
}
